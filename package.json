{
	"name": "remove-empty-assets",
	"version": "1.0.0",
	"description": "Delete empty directories inside configurable attachment directories for Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"attachments",
		"cleanup"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.4.11",
		"tslib": "^2.6.2",
		"typescript": "^5.3.0"
	}
}
